# Copie ce fichier en .env.local et remplis les clés (jamais commitées).
# Clé « API YouTube Data v3 » : console.cloud.google.com → nouveau projet → Bibliothèque → YouTube Data API v3 → Activer → Identifiants → Clé API.
YOUTUBE_API_KEY=
# Gemini (lit les vidéos YouTube par leur lien pour trouver les extraits).
GEMINI_API_KEY=
# Claude (notation des extraits).
ANTHROPIC_API_KEY=
# Optionnels
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-sonnet-5-5
# Images par seconde regardées par Gemini (0,5 par défaut ; 0,2 coûte encore moins, un peu moins précis).
# GEMINI_FPS=0.5

# Test local seulement : 1 = pas de limite par personne et par jour (ignoré en production).
# SANS_LIMITES=1

# Emails « Gemini est prêt » (resend.com). Sans ces deux lignes, rien ne part.
# RESEND_API_KEY=
# EMAIL_FROM=Viral Analyzer <bonjour@ton-domaine.fr>
